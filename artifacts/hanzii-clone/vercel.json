{
  "installCommand": "npm install",
  "buildCommand": "npx expo export -p web --output-dir dist",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!api/|.*\\..*).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
